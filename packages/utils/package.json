{
  "name": "@egoist/solid-base-utils",
  "version": "0.1.0",
  "description": "Framework-agnostic DOM helpers and SolidJS primitives shared by @egoist/solid-base.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./platform": {
      "source": "./src/platform/index.ts",
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@floating-ui/utils": "^0.2.12",
    "reselect": "^5.3.0"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0",
    "@solidjs/web": "^2.0.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  }
}
