{
  "name": "@egoist/solid-base",
  "version": "0.1.0",
  "description": "Unstyled, accessible UI components for SolidJS 2 \u2014 a port of Base UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/esm/index.js"
    },
    "./*": {
      "source": "./src/*/index.ts",
      "types": "./dist/types/*/index.d.ts",
      "solid": "./dist/source/*/index.js",
      "default": "./dist/esm/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@egoist/solid-base-utils": "workspace:*",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/utils": "^0.2.12",
    "tabbable": "^6.5.2"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0",
    "@solidjs/web": "^2.0.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json"
  }
}
