{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist/source",
    "declarationDir": "dist/types",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.test-d.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.spec.ts",
    "src/**/test-utils.ts",
    "src/**/test-utils.tsx",
    "src/**/testUtils.tsx",
    "src/**/*TestUtils.tsx",
    "src/**/test-fixtures.tsx",
    "src/**/__fixtures__/**"
  ]
}
